{
  "version": 1,
  "name": "{{DISPLAY_NAME_HEISENBERG}}",
  "model": {
    "default": "{{MAIN_MODEL}}",
    "thinking": "adaptive"
  },
  "apiKeys": {
    "anthropic": "{{ANTHROPIC_API_KEY}}",
    "openai": "{{OPENAI_API_KEY}}",
    "deepseek": "{{DEEPSEEK_API_KEY}}",
    "openrouter": "{{OPENROUTER_API_KEY}}"
  },
  "memory": {
    "enabled": true,
    "provider": "local",
    "embedding": {
      "provider": "{{EMBEDDING_PROVIDER}}",
      "model": "{{EMBEDDING_MODEL}}"
    }
  },
  "messages": {
    "queue": {
      "mode": "collect",
      "debounceMs": 1000,
      "debounceMsGroup": 3000,
      "cap": 20,
      "drop": "summarize"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true,
        "config": {
          "botToken": "{{TELEGRAM_BOT_TOKEN_HEISENBERG}}",
          "authorizedSenders": ["{{OWNER_TELEGRAM_ID}}"],
          "network": {
            "autoSelectFamily": true,
            "dnsResultOrder": "ipv4first"
          },
          "retry": {
            "attempts": 3,
            "minDelayMs": 400,
            "maxDelayMs": 30000,
            "jitter": 0.1
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "maxConcurrent": 3,
      "timeoutSeconds": 600
    },
    "safety": {
      "maxActionsPerHour": 100,
      "maxCostPerDay": 10.00,
      "currency": "USD"
    },
    "remoteAgents": {
      "saul": {
        "sessionKey": "agent:producer:main",
        "description": "Producer — coordinates content pipeline, ОТК, delivery"
      },
      "walter": {
        "sessionKey": "agent:teamlead:main",
        "description": "Tech lead — code, files, complex technical tasks"
      },
      "jesse": {
        "sessionKey": "agent:marketing-funnel:main",
        "description": "Marketing — funnels, CTR, analytics, copywriting"
      },
      "skyler": {
        "sessionKey": "agent:skyler:main",
        "description": "Finance — budgets, expenses, financial reports (silent)"
      },
      "hank": {
        "sessionKey": "agent:hank:main",
        "description": "Security — audits, monitoring, QA (silent)"
      },
      "gus": {
        "sessionKey": "agent:kaizen:main",
        "description": "Kaizen — goals, habits, Obsidian, optimization (silent)"
      },
      "twins": {
        "sessionKey": "agent:researcher:main",
        "description": "Research — web search, monitoring, data gathering (silent)"
      }
    }
  },
  "workspace": {
    "path": "~/openclaw-agents/heisenberg"
  },
  "heartbeat": {
    "enabled": true,
    "intervalMinutes": 30
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18789,
    "token": "{{GATEWAY_TOKEN}}"
  },
  "exec": {
    "defaultTimeoutSeconds": 30
  }
}

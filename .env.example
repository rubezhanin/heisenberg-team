# ============================================
# Heisenberg Team - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Replace all {{PLACEHOLDER}} with actual data

# --- OpenClaw Version ---
# Pin to a specific version (used by bootstrap-install.sh)
# OPENCLAW_VERSION=2026.4.12

# --- Gateway Security ---
# Auto-generated by setup-wizard.sh. Change only if you know what you're doing.
# GATEWAY_TOKEN=your-64-char-hex-token

# --- LLM Provider ---
# Uncomment YOUR provider:
ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# GOOGLE_API_KEY=your-google-key
# DEEPSEEK_API_KEY=your-deepseek-key
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# --- Embedding (for vector memory search) ---
# OpenAI recommended. Ollama for local embeddings (no API key needed).
# OPENAI_API_KEY=your-openai-key  # (same as above if using OpenAI as LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Groq Voice Transcription (optional) ---
# Fast cloud transcription via Groq Whisper API.
# GROQ_API_KEY=gsk_your-groq-key
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Models (set by setup wizard) ---
# MAIN_MODEL=anthropic/claude-opus-4-5       # For Heisenberg (boss)
# AGENT_MODEL=anthropic/claude-sonnet-4-5    # For other agents
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# --- Telegram (optional) ---
# TELEGRAM_BOT_TOKEN=your-bot-token           # Legacy single token
# OWNER_TELEGRAM_ID=your-telegram-id

# --- Per-Agent Telegram Bot Tokens ---
# Each agent can have its own bot. Set token per agent below.
# TELEGRAM_BOT_TOKEN_HEISENBERG=
# TELEGRAM_BOT_TOKEN_SAUL=
# TELEGRAM_BOT_TOKEN_WALTER=
# TELEGRAM_BOT_TOKEN_JESSE=
# TELEGRAM_BOT_TOKEN_SKYLER=
# TELEGRAM_BOT_TOKEN_HANK=
# TELEGRAM_BOT_TOKEN_GUS=
# TELEGRAM_BOT_TOKEN_TWINS=

# --- Personal Data ---
# Used in agent configs for personalization
OWNER_NAME=YourName
OWNER_SURNAME=YourSurname
OWNER_USERNAME=your-github-username
TEAM_LANG=en  # en or ru — language for agent technical instructions

# --- Paths ---
# WORKSPACE_PATH=~/workspace/
# PROJECTS_PATH=~/projects/

# --- GitHub (optional) ---
# GITHUB_ORG=your-github-org
# GITHUB_TOKEN=your-github-token

# --- Webhooks (optional) ---
# WEBHOOK_TOKEN=your_webhook_token_here

# --- Notifications (optional) ---
# GROUP_CHAT_ID=your-group-chat-id
# NOTIFY_CHANNEL_ID=your-notify-channel-id

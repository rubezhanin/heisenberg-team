# ============================================================================
# Heisenberg Team — Конфигурация окружения
# ============================================================================
# Скопируйте: cp .env.example .env
# Заполните и запустите: bash deploy-one-click.sh --yes
# ============================================================================

# ─── LLM Провайдер ──────────────────────────────────────────────────────────
# Один из: anthropic | openai | openrouter | google | deepseek | ollama
DEFAULT_PROVIDER=anthropic

# Модели (примеры для Anthropic; меняйте под свой провайдер)
DEFAULT_MODEL=claude-sonnet-4-20250514
BOSS_MODEL=claude-sonnet-4-20250514
SPECIALIST_MODEL=claude-sonnet-4-20250514

# ─── API Ключи (заполните хотя бы один) ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ─── Ollama (локальный инференс, бесплатно) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Telegram ────────────────────────────────────────────────────────────────
# Получите токены через @BotFather — по одному боту на агента
OWNER_TELEGRAM_ID=
TELEGRAM_BOT_TOKEN_HEISENBERG=
TELEGRAM_BOT_TOKEN_SAUL=
TELEGRAM_BOT_TOKEN_WALTER=
TELEGRAM_BOT_TOKEN_JESSE=
TELEGRAM_BOT_TOKEN_SKYLER=
TELEGRAM_BOT_TOKEN_HANK=
TELEGRAM_BOT_TOKEN_GUS=
TELEGRAM_BOT_TOKEN_TWINS=
TELEGRAM_BOT_TOKEN_WATCHDOG=

# ─── Персонализация ─────────────────────────────────────────────────────────
OWNER_NAME=
TEAM_LANG=ru

# ─── Безопасность (ВАЖНО!) ──────────────────────────────────────────────────
# Gateway ВСЕГДА должен слушать на 127.0.0.1, НИКОГДА на 0.0.0.0
# Token генерируется автоматически если пусто
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789
GATEWAY_TOKEN=

# Минимально безопасная версия OpenClaw (проверяется при установке)
OPENCLAW_VERSION=2026.4.12

# ─── Лимиты затрат ──────────────────────────────────────────────────────────
# Жёсткий лимит на API-вызовы в день (USD). При превышении агенты остановятся.
MAX_COST_PER_DAY=10.00
MAX_ACTIONS_PER_HOUR=100

# ─── Агенты ─────────────────────────────────────────────────────────────────
# all — все 9 агентов
# Или список через запятую: heisenberg,saul,walter
AGENTS=all